    {
      "parameters": {
        "functionCode": "const item = items[0];\nconst strippedContent = item.json.articleContent ? item.json.articleContent.replace(/<[^>]*>?/gm, '') : 'No content found.';\n\nconst text = `Source: ${item.json.source || 'N/A'}\\nTitle: ${item.json.articleTitle}\\nURL: ${item.json.articleUrl}\\nContent: ${strippedContent}`;\n\nitem.json.memoryText = text;\nitem.json.memoryKey = item.json.articleUrl; \n\nreturn item;",
        "options": {
          "memoryIdentifier": ""
        }
      },
      "name": "Format for Memory",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
