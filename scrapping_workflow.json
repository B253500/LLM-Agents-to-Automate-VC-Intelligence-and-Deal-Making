{
  "name": "Pitchbook Scraper",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "https://pitchbook.com/news/reports",
        "options": {
          "headers": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
          }
        },
        "responseFormat": "text"
      },
      "name": "Get Reports List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "mode": "onReceivedData",
        "dataPropertyName": "data",
        "extractValues": [
          {
            "key": "links",
            "cssSelector": "a[href^='/news/reports/']",
            "attribute": "href"
          }
        ]
      },
      "name": "Extract Links",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [840, 300]
    },
    {
      "parameters": {
        "url": "={{ 'https://pitchbook.com' + $node['Split In Batches'].json['links'] }}",
        "options": {
          "headers": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
          },
          "playwrightOptions": {
            "waitUntil": "domcontentloaded"
          }
        },
        "downloadOnUrlPattern": "/.*\\.pdf$/",
        "downloadLimit": 1
      },
      "name": "Playwright",
      "type": "n8n-nodes-base.playwright",
      "typeVersion": 1,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "url": "={{ $node['Playwright'].json['downloadUrls'][0] }}",
        "responseFormat": "file"
      },
      "name": "Download PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1240, 300]
    },
    {
      "parameters": {
        "binaryPropertyName": "data",
        "fileName": "={{ $node['Download PDF'].binary.data.fileName }}",
        "filePath": "/data/pitchbook-reports"
      },
      "name": "Write File",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [1440, 300]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Get Reports List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Reports List": {
      "main": [
        [
          {
            "node": "Extract Links",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Links": {
      "main": [
        [
          {
            "node": "Split In Batches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split In Batches": {
      "main": [
        [
          {
            "node": "Playwright",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Playwright": {
      "main": [
        [
          {
            "node": "Download PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download PDF": {
      "main": [
        [
          {
            "node": "Write File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
