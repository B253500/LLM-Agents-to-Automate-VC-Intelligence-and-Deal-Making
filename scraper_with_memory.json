        2620,
        360
      ]
    },
    {
      "parameters": {
        "memoryName": "VC-Report-Memory",
        "operation": "add",
        "key": "={{$json.memoryKey}}",
        "value": "={{$json.memoryText}}"
      },
      "id": "586a117d-2b99-4702-861f-1c448bb992dd",
      "name": "Add to Report Memory",
